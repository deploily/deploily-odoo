<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ================================================== -->
        <!-- CRON 1: Send Scheduled WhatsApp Blasting Messages  -->
        <!-- Runs every 1 minute to check submitted mailings    -->
        <!-- ================================================== -->
        <record id="ir_cron_send_whatsapp_blasting" model="ir.cron">
            <field name="name">Infinys Whatsapp Blasting : Scheduler Send</field>
            <field name="model_id" ref="model_infinys_whatsapp_mailing"/>
            <field name="state">code</field>
            <field name="code">model._send_whatsapp_blasting()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- ================================================== -->
        <!-- CRON 2: Enqueue via N8N Webhook (disabled)        -->
        <!-- Enable only if using N8N webhook flow             -->
        <!-- ================================================== -->
        <record id="ir_cron_send_whatsapp_enqueue" model="ir.cron">
            <field name="name">Infinys Whatsapp Blasting : Scheduler Enqueue</field>
            <field name="model_id" ref="model_infinys_whatsapp_mailing"/>
            <field name="state">code</field>
            <field name="code">model._execute_enqueue()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="False"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
        </record>

        <!-- ================================================== -->
        <!-- CRON 3: Process Queued Messages via Meta API       -->
        <!-- Runs every 2 minutes to send queued messages       -->
        <!-- ================================================== -->
        <record id="ir_cron_process_queued_messages" model="ir.cron">
            <field name="name">Infinys Whatsapp Blasting : Process Queued Messages</field>
            <field name="model_id" ref="model_infinys_whatsapp_sent"/>
            <field name="state">code</field>
            <field name="code">model._process_queued_messages()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>