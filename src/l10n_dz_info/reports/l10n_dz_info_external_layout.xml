<?xml version="1.0" encoding="UTF-8"?>


<odoo>

    <template id="l10n_dz_info.l10n_dz_info_additionnal_company_info">
        <t t-if="partner">
            <p class="mb-0">
                <strong>R.C: </strong>
                <span t-field="partner.rc" />
                <br />
                <strong>N.I.F: </strong>
                <span t-field="partner.nif" />
                <br />
                <strong>N.I.S: </strong>
                <span t-field="partner.nis" />
                <br />
                <strong>Article d'imposition: </strong>
                <span t-field="partner.ai" />
            </p>
        </t>
    </template>

    <template id="l10n_dz_info_external_layout__inherit_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//img[contains(@class, 'o_company_logo_small')]" position="attributes">
            <attribute name="style">max-width:340px; max-height:340px;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <div class="col-6" name="company_additional_info">
                <t t-set="partner" t-value="company.partner_id or None" />
                <t t-call="l10n_dz_info.l10n_dz_info_additionnal_company_info" />
            </div>
        </xpath>
    </template>

</odoo>